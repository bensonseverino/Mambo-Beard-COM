# Hashed build assets (Vite outputs filenames like index-a1b2c3.js) — safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — never cache long-term, it references the hashed assets
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root document
/
  Cache-Control: public, max-age=0, must-revalidate
